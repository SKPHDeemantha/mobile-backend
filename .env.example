# Copy to .env and fill in real values. Never commit .env.
#
# See README.md "Neon setup" for exactly how to obtain these three URLs —
# they use DIFFERENT database roles (app_api vs app_admin) created by
# sql/01_roles_and_grants.sql, not the Neon project owner role.

# Pooled endpoint (host ends in "-pooler"), app_api credentials.
# Used by the running FastAPI app for all normal request traffic.
DATABASE_URL=postgresql+asyncpg://app_api:CHANGE_ME@ep-example-pooler.region.aws.neon.tech/foodlence?ssl=require

# Direct (non-pooled) endpoint, the Neon-issued OWNER role (not app_api or
# app_admin — those two only have DML rights, not CREATE TABLE/ROLE). This
# is NOT read by the app itself (see app/core/config.py) — it's only used
# by a developer running scripts/apply_sql.py, seed_knowledge_base.py, or
# generate_embeddings.py by hand. Never set this in a deployed environment
# (Render/Railway) since the running API has no use for it and it would
# just be an unnecessary secret sitting in that dashboard.
DATABASE_URL_DIRECT=postgresql+asyncpg://neondb_owner:CHANGE_ME@ep-example.region.aws.neon.tech/foodlence?ssl=require

# Pooled endpoint, app_admin credentials. Used only by the SQLAdmin panel.
ADMIN_DATABASE_URL=postgresql+asyncpg://app_admin:CHANGE_ME@ep-example-pooler.region.aws.neon.tech/foodlence?ssl=require

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=20
REFRESH_TOKEN_EXPIRE_DAYS=30

# Separate secret for the SQLAdmin session cookie (not the JWT secret).
ADMIN_SESSION_SECRET=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_STRING

# Comma-separated origins the Flutter app / admin browser are served from.
CORS_ORIGINS=http://localhost,http://10.0.2.2

# Gmail SMTP + App Password (see README.md "Email setup"). Leave MAIL_FROM
# as the same Gmail address.
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=CHANGE_ME_APP_PASSWORD
MAIL_FROM=your-address@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# Keep false until hosting is confirmed to have enough RAM for
# sentence-transformers (see README.md "Turning on semantic matching").
ENABLE_SEMANTIC_MATCH=false

# Shared secret for the GitHub Actions -> /internal/maintenance/* cron
# endpoints (Neon's pg_cron can't schedule from a non-"postgres" database).
MAINTENANCE_API_KEY=CHANGE_ME_ANOTHER_RANDOM_STRING
